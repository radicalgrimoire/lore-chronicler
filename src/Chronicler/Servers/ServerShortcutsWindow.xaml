<Window x:Class="Chronicler.Servers.ServerShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server shortcuts - Chronicler" Width="700" Height="460"
        MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="Saved connections" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ListBox x:Name="ServerList" Grid.Row="1" DisplayMemberPath="Name"
                     AutomationProperties.Name="Saved connections" SelectionChanged="ServerList_SelectionChanged" />
            <Button x:Name="NewButton" Grid.Row="2" Content="New connection" Margin="0,10,0,0"
                    Padding="10,6" Click="NewButton_Click" />
        </Grid>
        <StackPanel Grid.Column="1">
            <TextBlock Text="Display name" />
            <TextBox x:Name="NameInput" Margin="0,4,0,12" Padding="6"
                     TextChanged="Inputs_TextChanged" AutomationProperties.Name="Display name" />
            <TextBlock Text="Server URL" />
            <TextBox x:Name="UrlInput" Margin="0,4,0,0" Padding="6"
                     TextChanged="Inputs_TextChanged" AutomationProperties.Name="Server URL" />
            <TextBlock Text="Example: lore://server.example.com:41337" Margin="0,4,0,0"
                       Foreground="DimGray" TextWrapping="Wrap" />
            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="SaveButton" Content="Save" Padding="14,6" Margin="0,0,8,8" Click="SaveButton_Click" />
                <Button x:Name="RemoveButton" Content="Delete" Padding="14,6" Margin="0,0,8,8" Click="RemoveButton_Click" />
            </WrapPanel>
            <TextBlock Text="Changing or deleting a connection does not affect existing projects or Lore credentials."
                       Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
