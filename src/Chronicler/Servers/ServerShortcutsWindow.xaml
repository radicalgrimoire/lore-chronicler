<Window x:Class="Chronicler.Servers.ServerShortcutsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接続先ショートカット - Chronicler" Width="700" Height="460"
        MinWidth="560" MinHeight="380" WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="保存済み接続先" FontWeight="SemiBold" Margin="0,0,0,8" />
            <ListBox x:Name="ServerList" Grid.Row="1" DisplayMemberPath="Name"
                     AutomationProperties.Name="保存済み接続先" SelectionChanged="ServerList_SelectionChanged" />
            <Button x:Name="NewButton" Grid.Row="2" Content="新規接続先" Margin="0,10,0,0"
                    Padding="10,6" Click="NewButton_Click" />
        </Grid>
        <StackPanel Grid.Column="1">
            <TextBlock Text="表示名（32文字以内）" />
            <TextBox x:Name="NameInput" Margin="0,4,0,12" Padding="6"
                     TextChanged="Inputs_TextChanged" AutomationProperties.Name="表示名" />
            <TextBlock Text="サーバーURL" />
            <TextBox x:Name="UrlInput" Margin="0,4,0,0" Padding="6"
                     TextChanged="Inputs_TextChanged" AutomationProperties.Name="サーバーURL" />
            <TextBlock Text="例: lore://server.example.com:41337" Margin="0,4,0,0"
                       Foreground="DimGray" TextWrapping="Wrap" />
            <WrapPanel Margin="0,16,0,0">
                <Button x:Name="SaveButton" Content="保存" Padding="14,6" Margin="0,0,8,8" Click="SaveButton_Click" />
                <Button x:Name="RemoveButton" Content="削除" Padding="14,6" Margin="0,0,8,8" Click="RemoveButton_Click" />
            </WrapPanel>
            <TextBlock Text="接続先の変更・削除は既存プロジェクトやLoreの認証情報に影響しません。"
                       Margin="0,8,0,0" TextWrapping="Wrap" />
        </StackPanel>
        <TextBlock x:Name="StatusText" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
