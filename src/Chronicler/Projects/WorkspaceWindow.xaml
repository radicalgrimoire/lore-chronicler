<Window x:Class="Chronicler.Projects.WorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:projects="clr-namespace:Chronicler.Projects"
        Title="Chronicler" Width="1100" Height="700" MinWidth="780" MinHeight="480"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing" Closed="Window_Closed">
    <Window.Resources>
        <DataTemplate DataType="{x:Type projects:StagedEntry}">
            <Border Background="{Binding Background}" Padding="4,2" Margin="0,1"
                    BorderBrush="{Binding StateColor}"
                    BorderThickness="3,0,0,0">
                <DockPanel Margin="{Binding Indent}" ToolTip="{Binding RelativePath}">
                    <Button Width="22" Padding="0" Margin="0,0,2,0" Click="ChangeFolder_Click"
                            Content="{Binding ExpandMarker}"
                            AutomationProperties.Name="{Binding ExpandAccessibleName}">
                        <Button.Style>
                            <Style TargetType="{x:Type Button}">
                                <Setter Property="Visibility" Value="Hidden" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <TextBlock Text="{Binding StateMarker}" Width="30" FontWeight="Bold"
                               ToolTip="{Binding StateText}" />
                    <TextBlock Text="{Binding Icon}" Width="24" FontWeight="Bold" ToolTip="{Binding ActionText}" />
                    <TextBlock Text="{Binding DirectoryActionIcon}" FontWeight="Bold" ToolTip="{Binding ActionText}" />
                    <TextBlock Text="{Binding TreeName}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="#F1F3F5" Padding="16,10">
            <TextBlock Text="Chronicler" FontSize="20" FontWeight="SemiBold" />
        </Border>
        <Border Grid.Row="1" Background="#F1F3F5" Padding="12,4,12,8">
            <WrapPanel>
                <Button x:Name="RefreshTreeButton" Content="Refresh" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Refresh local files and changes, and retrieve locks from the server. Scanning updates Lore's local metadata."
                        Click="RefreshTreeButton_Click" />
                <Button x:Name="GetLatestButton" Content="Get latest" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Clone the project on first use, or update it to the latest server revision."
                        Click="GetLatestButton_Click" />
                <Button x:Name="PushButton" Content="Push" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Push committed history on the current branch to the server."
                        Click="PushButton_Click" />
                <Button x:Name="LoginButton" Content="Sign in" Padding="12,6" Margin="0,0,8,0"
                        ToolTip="Sign in to the selected project's server." Click="LoginButton_Click" />
                <Button x:Name="ManageServersButton" Content="Manage connections" Padding="12,6" Margin="0,0,8,0"
                        Click="ManageServersButton_Click" />
            </WrapPanel>
        </Border>
        <Grid Grid.Row="2" Margin="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8">
                    <Button x:Name="OpenFolderButton" Content="Open folder" DockPanel.Dock="Right"
                            Padding="10,4" Click="OpenFolderButton_Click" />
                    <StackPanel>
                        <TextBlock x:Name="ActiveProjectText" Margin="0,4,0,0" TextWrapping="Wrap" />
                        <TextBlock x:Name="AuthenticationStatusText" Margin="0,4,0,0"
                                   TextWrapping="Wrap" Foreground="DimGray"
                                   AutomationProperties.Name="Authentication status" />
                        <TextBlock x:Name="CurrentBranchText" Text="Branch:" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,4,0,0">
                            <ComboBox x:Name="BranchList" Width="210" MinWidth="100" DisplayMemberPath="Name"
                                      AutomationProperties.Name="Branch" SelectionChanged="BranchList_SelectionChanged" />
                            <Button x:Name="RefreshBranchesButton" Content="Get list" Padding="8,4" Margin="6,0,0,0"
                                    Click="RefreshBranchesButton_Click" />
                            <Button x:Name="SwitchBranchButton" Content="Switch" Padding="8,4" Margin="6,0,0,0"
                                    Click="SwitchBranchButton_Click" />
                        </WrapPanel>
                    </StackPanel>
                </DockPanel>
                <TreeView x:Name="FileTree" Grid.Row="1" AutomationProperties.Name="Local files"
                          PreviewMouseDown="FileTree_PreviewMouseDown"
                          ContextMenuOpening="FileTree_ContextMenuOpening"
                          VirtualizingStackPanel.IsVirtualizing="True"
                          VirtualizingStackPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                    <TreeView.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="AcquireFileLockMenu" Header="Lock" Click="AcquireFileLock_Click" />
                        </ContextMenu>
                    </TreeView.ContextMenu>
                    <TreeView.Resources>
                        <Style TargetType="{x:Type TreeViewItem}">
                            <Setter Property="HeaderTemplate">
                                <Setter.Value>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock x:Name="HeaderText" Text="{Binding}" Padding="2,1" />
                                            <TextBlock x:Name="LockIcon" Text="🔒" Margin="4,0,0,0"
                                                       FontFamily="Segoe UI Emoji"
                                                       ToolTip="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=(AutomationProperties.HelpText)}"
                                                       AutomationProperties.Name="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=(AutomationProperties.HelpText)}">
                                                <TextBlock.Style>
                                                    <Style TargetType="{x:Type TextBlock}">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=(AutomationProperties.HelpText)}" Value="">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type TreeViewItem}}, Path=(AutomationProperties.HelpText)}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TreeView.Resources>
                </TreeView>
            </Grid>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#D8DDE2" />
            <TabControl x:Name="WorkspaceTabs" Grid.Column="2" Margin="12,0,0,0"
                        AutomationProperties.Name="Workspace tabs">
                <TabItem x:Name="ProjectsTab" Header="Projects">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <WrapPanel Margin="0,0,0,10">
                            <Button x:Name="CreateProjectButton" Content="New project" Padding="12,6" Margin="0,0,8,0"
                                    Click="CreateProjectButton_Click" />
                            <Button x:Name="SwitchProjectButton" Content="Switch project" Padding="12,6" Margin="0,0,8,0"
                                    Click="SwitchProjectButton_Click" />
                            <Button x:Name="RenameProjectButton" Content="Rename" Padding="12,6" Margin="0,0,8,0"
                                    Click="RenameProjectButton_Click" />
                            <Button x:Name="RemoveProjectButton" Content="Remove registration" Padding="12,6"
                                    Click="RemoveProjectButton_Click" />
                        </WrapPanel>
                        <ListBox x:Name="ProjectList" Grid.Row="1" DisplayMemberPath="Name"
                                 SelectionChanged="ProjectList_SelectionChanged"
                                 MouseDoubleClick="ProjectList_MouseDoubleClick"
                                 AutomationProperties.Name="Saved projects" />
                        <StackPanel Grid.Row="2" Margin="0,10,0,0">
                            <TextBlock x:Name="ProjectDetails" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="StageTab" Header="Changes">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBox x:Name="StageStatusText" Grid.Row="0" Margin="0,0,0,8"
                                 Text="Open a project to view changes." TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Padding="0" MaxHeight="100" VerticalScrollBarVisibility="Auto" />
                        <ComboBox x:Name="ChangeFilter" Grid.Row="1" Margin="0,0,0,6"
                                  SelectedIndex="0" SelectionChanged="ChangeFilter_SelectionChanged"
                                  AutomationProperties.Name="Change filter">
                            <ComboBoxItem Content="All changes" />
                            <ComboBoxItem Content="Unstaged changes" />
                            <ComboBoxItem Content="Staged changes" />
                        </ComboBox>
                        <ListBox x:Name="ChangeList" Grid.Row="2" SelectionMode="Extended"
                                 AutomationProperties.Name="Changes"
                                 HorizontalContentAlignment="Stretch"
                                 SelectionChanged="StageList_SelectionChanged"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.CanContentScroll="True">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="{x:Type ListBoxItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding AccessibleName}" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                        <WrapPanel Grid.Row="3" Margin="0,8,0,0">
                            <Button x:Name="StageSelectionButton" Content="Stage" Margin="0,0,8,0"
                                    Padding="10,4" Click="StageSelectionButton_Click"
                                    ToolTip="Stage selected changes, including changes in selected folders." />
                            <Button x:Name="UnstageButton" Content="Unstage"
                                    Padding="10,4" Click="UnstageButton_Click"
                                    ToolTip="Unstage selected changes, including staged changes in selected folders." />
                        </WrapPanel>
                        <StackPanel Grid.Row="4" Margin="0,10,0,0">
                            <TextBlock x:Name="CommitTargetText" Text="Commit target: not checked" FontWeight="SemiBold" />
                            <TextBlock Text="Commit message" FontWeight="SemiBold" />
                            <TextBox x:Name="CommitMessageText" Margin="0,4,0,0" Height="68"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     AutomationProperties.Name="Commit message"
                                     TextChanged="CommitMessageText_TextChanged" />
                            <TextBlock Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="All staged changes are committed, regardless of the current selection or filter." />
                            <Button x:Name="CommitButton" Content="Commit" HorizontalAlignment="Right"
                                    Margin="0,6,0,0" Padding="12,6" Click="CommitButton_Click"
                                    ToolTip="Create a local commit. Push separately to send it to the server." />
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem x:Name="UpdateLogTab" Header="Update log">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel>
                            <Button x:Name="RefreshHistoryButton" DockPanel.Dock="Right" Content="Refresh history"
                                    Padding="10,4" Click="RefreshHistoryButton_Click"
                                    ToolTip="Missing history data is retrieved from the server." />
                            <TextBlock Text="Current branch history (up to 100 revisions)"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                        <TextBox x:Name="HistoryStatus" Grid.Row="1" Margin="0,8,0,8"
                                 Text="Open a project to view history." TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Padding="0" MaxHeight="160" VerticalScrollBarVisibility="Auto" />
                        <ListBox x:Name="RevisionHistoryList" Grid.Row="2"
                                 AutomationProperties.Name="Revision history"
                                 HorizontalContentAlignment="Stretch"
                                 VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <WrapPanel>
                                            <TextBlock Text="Revision " />
                                            <TextBlock Text="{Binding Number}" FontWeight="SemiBold" />
                                            <TextBlock Text="  " />
                                            <TextBlock Text="{Binding DisplayTimestamp}" />
                                        </WrapPanel>
                                        <TextBlock Text="{Binding DisplayMessage}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding DisplayAuthor}" />
                                        <TextBlock Text="{Binding Revision}" TextWrapping="Wrap" FontSize="10" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
                <TabItem x:Name="FileLocksTab" Header="Locks">
                    <Grid Margin="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <WrapPanel>
                            <Button x:Name="RefreshMyLocksButton" Content="Get list" Padding="12,6" Margin="0,0,8,0"
                                    Click="RefreshMyLocks_Click" />
                            <Button x:Name="ReleaseMyLockButton" Content="Release selected lock" Padding="12,6"
                                    Click="ReleaseMyLock_Click" />
                        </WrapPanel>
                        <TextBox x:Name="MyLocksStatusText" Grid.Row="1" Margin="0,8" TextWrapping="Wrap"
                                 IsReadOnly="True" BorderThickness="0" Background="Transparent"
                                 Text="Open a project to view locks." />
                        <ListBox x:Name="MyLocksList" Grid.Row="2" SelectionChanged="MyLocksList_SelectionChanged"
                                 AutomationProperties.Name="Your locks" HorizontalContentAlignment="Stretch">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="2,4">
                                        <TextBlock Text="{Binding RelativePath}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Branch, StringFormat=BranchID: {0}}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
        <Border Grid.Row="3" Background="#F1F3F5" Padding="12,8">
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" />
        </Border>
    </Grid>
</Window>
