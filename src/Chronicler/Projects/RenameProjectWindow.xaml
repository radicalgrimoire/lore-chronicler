<Window x:Class="Chronicler.Projects.RenameProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロジェクト名の変更" SizeToContent="Height" Width="420"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="プロジェクト名" />
        <TextBox x:Name="NameInput" Margin="0,6,0,0" Padding="6" />
        <TextBlock x:Name="ErrorText" Margin="0,6,0,0" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="保存" Padding="12,6" Margin="0,0,8,0" IsDefault="True" Click="Save_Click" />
            <Button Content="キャンセル" Padding="12,6" IsCancel="True" />
        </StackPanel>
    </StackPanel>
</Window>
