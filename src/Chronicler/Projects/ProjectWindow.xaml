<Window x:Class="Chronicler.Projects.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Create project - Chronicler" Height="700" Width="700"
        MinHeight="540" MinWidth="600" WindowStartupLocation="CenterOwner" Closing="Window_Closing" Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="Choose a folder. An existing Lore clone can be registered; for a new clone, select a server and repository."
                   TextWrapping="Wrap" />
        <StackPanel x:Name="ProjectNameSection" Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Project name (leave blank to use the repository name)" TextWrapping="Wrap" />
            <TextBox x:Name="ProjectName" Margin="0,4,0,0" Padding="6" TextChanged="ProjectName_TextChanged" />
        </StackPanel>
        <StackPanel x:Name="ProjectFolderSection" Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="Project folder" />
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="Choose folder"
                        Padding="10,6" Margin="8,0,0,0" Click="BrowseButton_Click" />
                <TextBox x:Name="LocalPath" Padding="6" AutomationProperties.Name="Project folder"
                         TextChanged="LocalPath_TextChanged" LostFocus="LocalPath_LostFocus" />
            </DockPanel>
        </StackPanel>
        <StackPanel x:Name="ServerSection" Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="Server URL (for a new clone)" />
            <ComboBox x:Name="ServerUrlInput" Margin="0,4,0,0" Padding="6"
                      IsEditable="True"
                      AutomationProperties.Name="Server URL"
                      TextBoxBase.TextChanged="ServerUrlInput_TextChanged"
                      SelectionChanged="ServerUrlInput_SelectionChanged" />
        </StackPanel>
        <Button x:Name="FetchButton" Grid.Row="4" Content="Get repository list"
                HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,8" Click="FetchButton_Click" />
        <ListBox x:Name="RepositoryList" Grid.Row="5" SelectionChanged="RepositoryList_SelectionChanged"
                 AutomationProperties.Name="Repositories" />
        <Button x:Name="CreateButton" Grid.Row="6" Content="Review and create" HorizontalAlignment="Left"
                Padding="14,7" Margin="0,12,0,0" Click="CreateButton_Click" />
        <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
