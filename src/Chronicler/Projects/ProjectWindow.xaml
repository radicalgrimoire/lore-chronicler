<Window x:Class="Chronicler.Projects.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="プロジェクト作成 - Chronicler" Height="700" Width="700"
        MinHeight="540" MinWidth="600" WindowStartupLocation="CenterOwner" Closing="Window_Closing" Closed="Window_Closed">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Text="フォルダーを指定してください。既存のLoreリポジトリは情報を読み取って登録します。新規cloneの場合はサーバーとリポジトリを選んでください。"
                   TextWrapping="Wrap" />
        <StackPanel x:Name="ProjectNameSection" Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="プロジェクト名（既存cloneの場合は空欄でリポジトリ名を使用）" TextWrapping="Wrap" />
            <TextBox x:Name="ProjectName" Margin="0,4,0,0" Padding="6" TextChanged="ProjectName_TextChanged" />
        </StackPanel>
        <StackPanel x:Name="ProjectFolderSection" Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Text="プロジェクトフォルダー" />
            <DockPanel Margin="0,4,0,0">
                <Button x:Name="BrowseButton" DockPanel.Dock="Right" Content="フォルダーを選択"
                        Padding="10,6" Margin="8,0,0,0" Click="BrowseButton_Click" />
                <TextBox x:Name="LocalPath" Padding="6" AutomationProperties.Name="プロジェクトフォルダー"
                         TextChanged="LocalPath_TextChanged" LostFocus="LocalPath_LostFocus" />
            </DockPanel>
        </StackPanel>
        <StackPanel x:Name="ServerSection" Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="サーバーURL（新規cloneの場合）" />
            <ComboBox x:Name="ServerUrlInput" Margin="0,4,0,0" Padding="6"
                      IsEditable="True"
                      AutomationProperties.Name="サーバーURL"
                      TextBoxBase.TextChanged="ServerUrlInput_TextChanged"
                      SelectionChanged="ServerUrlInput_SelectionChanged" />
        </StackPanel>
        <Button x:Name="FetchButton" Grid.Row="4" Content="リポジトリ一覧を取得"
                HorizontalAlignment="Left" Padding="12,7" Margin="0,10,0,8" Click="FetchButton_Click" />
        <ListBox x:Name="RepositoryList" Grid.Row="5" SelectionChanged="RepositoryList_SelectionChanged"
                 AutomationProperties.Name="リポジトリ" />
        <Button x:Name="CreateButton" Grid.Row="6" Content="確認して作成" HorizontalAlignment="Left"
                Padding="14,7" Margin="0,12,0,0" Click="CreateButton_Click" />
        <TextBlock x:Name="StatusText" Grid.Row="7" Margin="0,12,0,0" TextWrapping="Wrap" />
    </Grid>
</Window>
