<Window x:Class="Chronicler.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loreログイン" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <StackPanel Margin="20">
        <TextBlock x:Name="ServerText" TextWrapping="Wrap" />
        <TextBlock Text="ログインするか、既存の認証情報で続行してください。" Margin="0,10,0,0" TextWrapping="Wrap" />
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="LoginButton" Content="ログイン" Padding="12,6" Margin="0,0,8,0" Click="Login_Click" />
            <Button x:Name="ContinueButton" Content="既存の認証情報で続行" Padding="12,6" Margin="0,0,8,0" Click="Continue_Click" />
            <Button x:Name="CancelButton" Content="キャンセル" Padding="12,6" IsCancel="True" />
        </WrapPanel>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="CodeText" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Button x:Name="BrowserButton" Content="ブラウザーをもう一度開く" Visibility="Collapsed"
                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Click="Browser_Click" />
    </StackPanel>
</Window>
