<Window x:Class="Chronicler.Authentication.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Lore sign-in" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Closing="Window_Closing">
    <StackPanel Margin="20">
        <TextBlock x:Name="ServerText" TextWrapping="Wrap" />
        <TextBlock Text="Sign in or continue with existing credentials." Margin="0,10,0,0" TextWrapping="Wrap" />
        <WrapPanel Margin="0,12,0,0">
            <Button x:Name="LoginButton" Content="Sign in" Padding="12,6" Margin="0,0,8,0" Click="Login_Click" />
            <Button x:Name="ContinueButton" Content="Continue with existing credentials" Padding="12,6" Margin="0,0,8,0" Click="Continue_Click" />
            <Button x:Name="CancelButton" Content="Cancel" Padding="12,6" IsCancel="True" />
        </WrapPanel>
        <TextBlock x:Name="StatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
        <TextBlock x:Name="CodeText" Margin="0,8,0,0" TextWrapping="Wrap" />
        <Button x:Name="BrowserButton" Content="Open browser again" Visibility="Collapsed"
                HorizontalAlignment="Left" Margin="0,8,0,0" Padding="12,6" Click="Browser_Click" />
    </StackPanel>
</Window>
